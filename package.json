{
    "name": "decky-voice-keyboard",
    "version": "0.1.0",
    "private": true,
    "description": "Steam Deck plugin: a microphone button for the Steam virtual keyboard that transcribes speech locally and inserts the final transcript as one complete payload.",
    "type": "module",
    "license": "MIT",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "validate:manifests": "node scripts/validate-manifests.mjs",
        "validate:licenses": "node scripts/validate-licenses.mjs"
    },
    "dependencies": {
        "@decky/api": "1.1.3",
        "@decky/ui": "4.12.1",
        "react": "~18.3.1",
        "react-dom": "~18.3.1"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "29.0.3",
        "@rollup/plugin-json": "6.1.0",
        "@rollup/plugin-node-resolve": "16.0.3",
        "@testing-library/react": "16.3.3",
        "@types/react": "~18.3.31",
        "@types/react-dom": "~18.3.7",
        "eslint": "10.10.0",
        "jsdom": "30.0.1",
        "prettier": "3.9.7",
        "rollup": "4.63.3",
        "rollup-plugin-esbuild": "~6.2.1",
        "typescript": "~5.9.3",
        "typescript-eslint": "8.70.0",
        "vitest": "5.0.1"
    }
}
