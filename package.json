{
    "name": "speechtodeck",
    "version": "0.2.6",
    "private": true,
    "description": "Steam Deck plugin: a microphone button for the Steam virtual keyboard that transcribes speech locally and inserts the final transcript as one complete payload.",
    "type": "module",
    "license": "MIT",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "validate:manifests": "node scripts/validate-manifests.mjs",
        "validate:licenses": "node scripts/validate-licenses.mjs"
    },
    "dependencies": {
        "@decky/api": "1.1.3",
        "@decky/ui": "4.12.1",
        "react": "~18.3.1",
        "react-dom": "~18.3.1"
    },
    "remote_binary": [
        {
            "name": "voxtype-avx2",
            "url": "https://github.com/peteonrails/voxtype/releases/download/v1.0.1/voxtype-1.0.1-linux-x86_64-avx2",
            "sha256hash": "cb3843a894ef47aca230b30bb1c45c2ef8e0d015adf2fa754d60e55123165fd0"
        },
        {
            "name": "voxtype-vulkan",
            "url": "https://github.com/peteonrails/voxtype/releases/download/v1.0.1/voxtype-1.0.1-linux-x86_64-vulkan",
            "sha256hash": "c569d038057464aa60290296794bcbd79b928ee0efd038e33062a4c015558ed8"
        }
    ],
    "devDependencies": {
        "@decky/rollup": "^1.0.2",
        "@rollup/plugin-commonjs": "29.0.3",
        "@rollup/plugin-node-resolve": "16.0.3",
        "@testing-library/react": "16.3.3",
        "@types/node": "^24.13.5",
        "@types/react": "~18.3.31",
        "@types/react-dom": "~18.3.7",
        "eslint": "10.10.0",
        "jsdom": "30.0.1",
        "prettier": "3.9.7",
        "rollup": "4.63.3",
        "rollup-plugin-esbuild": "~6.2.1",
        "typescript": "~5.9.3",
        "typescript-eslint": "8.70.0",
        "vitest": "5.0.1"
    }
}
